<% layout('/layouts/boilerplate.ejs') -%>
<!-- <h3>All Listings</h3> -->

<style>
  #filters{
    display: flex;
    flex-wrap: wrap;
  }
  .filter{
    text-align: center;
    margin-right: 2rem;
    opacity: 0.6;
  }

  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }

  .filter p{
    font-size: 1rem;
  }

  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 2.8rem;
    padding: 1rem;
    margin-left: 3rem;
    display: flex;
    align-items: center;
  }

  .tax-switch-on {
    display: none;
  }

  .tax-switch-off {
    display: block;
  }

  #listing-grid.show-tax-inclusive .tax-switch-on {
    display: block;
  }

  #listing-grid.show-tax-inclusive .tax-switch-off {
    display: none;
  }

</style>

<div id="filters">
  <div class="filter mb-3">
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
  </div>
  <div class="filter mb-3">
    <i class="fa-solid fa-bed"></i>
    <p>Rooms</p>
  </div>
  <div class="filter mb-3">
    <i class="fa-solid fa-mountain-city"></i>
    <p>Iconic Cities</p>
  </div>
  <div class="filter mb-3">
    <i class="fa-brands fa-fort-awesome"></i>
    <p>Mountain</p>
  </div>
  <div class="filter mb-3">
    <i class="fa-solid fa-person-swimming"></i>
    <p>Amazing Pools</p>
  </div>
  <div class="filter mb-3">
    <i class="fa-solid fa-campground"></i>
    <p>Camping</p>
  </div>
  <div class="filter mb-3">
    <i class="fa-solid fa-cow"></i>
    <p>Farms</p>
  </div>
  <div class="filter mb-3">
    <i class="fa-solid fa-snowflake"></i>
    <p>Arctic</p>
  </div>
  <div class="filter mb-3">
    <i class="fa-solid fa-igloo"></i>
    <p>Domes</p>
  </div>
  <div class="filter mb-3">
    <i class="fa-solid fa-ship"></i>
    <p>Boats</p>
  </div>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
      <label class="form-check-label" for="taxSwitch">Display total after taxes</label>
    </div>
  </div>
</div>
<div id="listing-grid" class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing.id %>" style="text-decoration: none;" class="listing-link">
      <div class="card col listing-card mb-3">
        <img src="<%= listing.image.url %>" class="card-img-top hover-opacity-point5" alt="Listing">
        <div class="tax-switch-off card-body">
          <p class="card-text"><%= listing.title %>
          <br>
          &#8377; <%= listing.price.toLocaleString("en-IN") %>
          <br>
          <%= listing.location %>, <%= listing.country %></p>
        </div>
        <div class="tax-switch-on card-body">
          <p class="card-text"><%= listing.title %>
          <br>
          &#8377; <%= (listing.price * 1.18).toLocaleString("en-IN") %>
          <br>
          <%= listing.location %>, <%= listing.country %></p>
        </div>
      </div>
    </a>
  <% } %>
</div>


<script>
  const taxSwitch = document.getElementById("taxSwitch");
  const listingGrid = document.getElementById("listing-grid");

  taxSwitch.addEventListener("change", () => {
    listingGrid.classList.toggle("show-tax-inclusive", taxSwitch.checked);
  });
</script>
