<% layout('/layouts/boilerplate.ejs') -%>

<div class="row mb-3">
  <div class="card col-8 offset-2 mb-3" style="max-width: 2040px">
    <h3 class="mb-3 card-title"><%= listingInfo.title %></h3>
    <img
      src="<%= listingInfo.image.url %>"
      class="card-img-top"
      style="height: 16rem; background-size: cover"
      alt="Listing"
    />
    <div class="card-body">
      <p class="card-text mb-2"><%= listingInfo.description %></p>
      <p class="card-text">
        &#8377; <%= listingInfo.price.toLocaleString("en-IN") %>
        <br />
        <%= listingInfo.country %>
      </p>
      <div class="showCardBtn">
        <form action="/listings/<%= listingInfo.id %>/edit" method="get">
          <button class="btn btn-info">Edit</button>
        </form>
        <form
          action="/listings/<%= listingInfo.id %>?_method=DELETE"
          method="post"
        >
          <button class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-8 offset-2 mb-3" style="max-width: 2040px">
    <h4>Leave a Review</h4>
    <form class="needs-validation" action="/listings/<%= listingInfo.id %>/review" method="post" novalidate>
      <div>
        <label for="rating" class="form-label">Rate Us</label>
        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range" />
      </div>
      <div class="mb-2">
        <label for="comment" class="form-label">Leave a comment</label>
        <textarea
          class="form-control"
          name="review[comment]"
          id="comment"
          cols="40"
          rows="4"
          required
        ></textarea>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please provide a Comment.</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
  </div>

  <div class="col-8 offset-2 mb-3" style="max-width: 2040px" >
    <hr>
    <p><b>All Reviews</b></p>
    <div class="row">
      <% for(review of listingInfo.reviews) {%>
        <div class="card col-5 ms-4 me-3 mb-3">
          <div class="card-body">
            <h6 class="card-subtitle mb-1">Username</h6>
            <p class="card-text mb-1"><%= review.rating %> Stars</p>
            <p class="card-text"><%= review.comment %></p>
          </div>
          <form method="POST" action="<%= listingInfo.id %>/reviews/<%= review.id %>?_method=DELETE">
            <button class="btn btn-sm btn-danger mb-2 ms-2">Delete</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>
