<% layout('/layouts/boilerplate.ejs') -%>

<div class="row mb-3">
  <div class="card col-8 offset-2 mb-3" style="max-width: 2040px">
    <h3 class="mb-3 card-title"><%= listingInfo.title %></h3>
    <img
      src="<%= listingInfo.image.url %>"
      class="card-img-top"
      style="height: 16rem; background-size: cover"
      alt="Listing"
    />
    <div class="card-body">
      <p class="card-text mb-1">
        Owner by
        <i>
          <%=  listingInfo.owner.username %>
        </i>
      </p>
      <p class="card-text"> <%= listingInfo.description %>
        <br>
        &#8377; <%= listingInfo.price.toLocaleString("en-IN") %>
        <br />
        <%= listingInfo.country %>
      </p>
      <% if(currentUser && currentUser._id.equals(listingInfo.owner._id)) { %>
      <div class="showCardBtn">
        <form action="/listings/<%= listingInfo.id %>/edit" method="get">
          <button class="btn btn-info">Edit</button>
        </form>
        <form
          action="/listings/<%= listingInfo.id %>?_method=DELETE"
          method="post"
        >
          <button class="btn btn-danger">Delete</button>
        </form>
      </div>
      <% } %>
    </div>
  </div>
  <% if(currentUser) { %>
  <div class="col-8 offset-2 mb-3" style="max-width: 2040px">
    <h4>Leave a Review</h4>
    <form class="needs-validation" action="/listings/<%= listingInfo.id %>/reviews" method="post" novalidate>
      <div>
        <label for="rating" class="form-label">Rate Us</label>
        <fieldset class="starability-fade">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      <div class="mb-2">
        <label for="comment" class="form-label">Leave a comment</label>
        <textarea
          class="form-control"
          name="review[comment]"
          id="comment"
          cols="40"
          rows="4"
          required
        ></textarea>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please provide a Comment.</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
  </div>
  <% } %>

  <div class="col-8 offset-2 mb-3" style="max-width: 2040px" >
    <hr>
    <p><b>All Reviews</b></p>
    <div class="row">
      <% for(review of listingInfo.reviews) {%>
        <div class="card col-5 ms-4 me-3 mb-3">
          <div class="card-body">
            <h6 class="card-subtitle mb-1">@<%= review.author && review.author.username ? review.author.username : "User" %></h6>
            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
            <p class="card-text"><%= review.comment %></p>
          </div>
          <% if (currentUser && review.author && review.author._id && currentUser._id.equals(review.author._id)) { %>
            <form method="POST" action="<%= listingInfo.id %>/reviews/<%= review.id %>?_method=DELETE">
              <button class="btn btn-sm btn-danger mb-2 ms-2">Delete</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>
