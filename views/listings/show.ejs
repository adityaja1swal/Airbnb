<% layout('/layouts/boilerplate.ejs') -%>
<body>
  <div class="card" style="max-width: 540px;">
    <img src="<%= listingInfo.image.url %>" class="card-img-top"  style="height: 16rem; background-size: cover;" alt="Listing">
    <div class="card-body">
      <h5 class="card-title"><%= listingInfo.title %></h5>
      <p class="card-text mb-2"><%= listingInfo.description %></p>
      <p class="card-text">&#8377; <%= listingInfo.price.toLocaleString("en-IN") %>
      <br>
      <%= listingInfo.country %></p>
      <div class="showCardBtn">
        <form action="/listings/<%= listingInfo.id %>/edit" method="get">
          <button class="btn btn-info">Edit</button>
        </form>
        <form action="/listings/<%= listingInfo.id %>?_method=DELETE" method="post">
          <button class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</body>
